# MMS R8.6 Native Local Acceptance Test Environment Configuration
# NOTE: This file is an example template and MUST NOT contain real credentials.
# Copy to .env or .env.test for local development / acceptance testing.

# Environment Identification
# Allowed values: local, test, staging, production
APP_ENV=test
NODE_ENV=test

# Application Base URL
APPLICATION_BASE_URL=http://localhost:3000
PORT=3000
HOST=127.0.0.1

# Database Connectivity (PostgreSQL 18.7 Native)
# Separate database per environment (postgres, mms_dev, mms_test, mms_acceptance)
DATABASE_URL=postgresql://postgres:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/mms_acceptance

# Database Identity Separation (ADR-0011 / ADR-0021 / R8.6.3)
# Bootstrap / Migration Administrator (runs migrations, DDL)
MIGRATOR_DATABASE_URL=postgresql://migrator:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/mms_acceptance

# Auth Gateway Connection (runs iam.session and auth functions)
AUTH_GATEWAY_DATABASE_URL=postgresql://auth_gateway:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/mms_acceptance

# MMS Worker Connection (restricted outbox leasing and processing)
WORKER_DATABASE_URL=postgresql://worker:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/mms_acceptance

# Audit Sealer Connection (restricted audit hash chain sealing)
AUDIT_SEALER_DATABASE_URL=postgresql://audit_sealer:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/mms_acceptance

# PostgREST 16.5 Configuration
# Authenticator connection URI used by native PostgREST daemon:
PGRST_DB_URI=postgres://authenticator:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/mms_acceptance
PGRST_DB_SCHEMAS=api
PGRST_DB_ANON_ROLE=web_anon
PGRST_SERVER_PORT=3001
MMS_PGRST_URL=http://127.0.0.1:3001

# Storage Configuration (Local Acceptance Test Storage)
# Local directory for quarantine, clean, and infected uploads (outside git tracking)
TEST_STORAGE_ROOT=.testdata
AZURE_STORAGE_ACCOUNT=teststorage
AZURE_STORAGE_CONTAINER=quarantine

# Test Adapters & Notification Sink
# Local notification sink (e.g. Mailpit or built-in test sink)
NOTIFICATION_SINK_URL=http://127.0.0.1:8025
MAIL_FROM=mms-test@acceptance.local

# -----------------------------------------------------------------------------
# UNSAFE TEST SWITCHES
# WARNING: These switches must ONLY be enabled in local/test environments.
# MMS application and worker startup WILL FAIL FAST if APP_ENV=production or
# NODE_ENV=production when any of these switches are enabled.
# -----------------------------------------------------------------------------
ALLOW_DEV_LOGIN=true
ALLOW_TEST_SCANNER=true
ALLOW_TEST_STORAGE=true
MMS_AUTH_STUB=1
